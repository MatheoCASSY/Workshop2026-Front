# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=workshop2026

# Supabase (Auth + stockage + Postgres)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement : contourne toutes les RLS, ne jamais exposer au client
SUPABASE_SERVICE_ROLE_KEY=

# Connexion Postgres directe, utilisee par npm run db:migrate
# (port 5432 et non le pooler 6543 : le pooler ne supporte pas tout le DDL)
POSTGRES_URL_NON_POOLING=

APP_URL=http://localhost:3000
